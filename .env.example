# Priceflag — environment. Copy to .env.local and fill in.
# Everything here has a free tier. Demo mode needs none of it.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# demo = simulated store, file-backed state, no network. real = Shopify + Supabase.
PRICEFLAG_MODE=demo

# Where DemoAdapter persists its state (demo mode only).
# PRICEFLAG_DEMO_STATE=.priceflag/demo-state.json

# ---------------------------------------------------------------------------
# Shopify (Partner account -> development store -> custom app; free, no review)
# ---------------------------------------------------------------------------
# --- Path A: admin-created custom app (dev store; what B3's sync runs against) ---
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps.
# This app type authenticates with a STATIC Admin API token: no OAuth, no install
# flow. It also has full order history WITHOUT `read_all_orders` — that scope is
# not offered in the admin checkbox list, and asking for it in OAuth fails.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Path B: Partner-Dashboard app with custom distribution (pilots; OAuth) ---
# Needed to install on stores you do not own. `read_all_orders` and
# protected-customer-data access must be requested and approved for this path.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,write_draft_orders
# Admin GraphQL API version. Shopify versions quarterly (Jan/Apr/Jul/Oct);
# each version is supported for 12 months. Verify at shopify.dev before bumping.
SHOPIFY_API_VERSION=2026-07

# ---------------------------------------------------------------------------
# Supabase (free tier)
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Read-only role used by the Python ML lane (Lane C). Landed in Sprint B6.
SUPABASE_ML_READONLY_KEY=

# ---------------------------------------------------------------------------
# Email (Resend free tier) — landed in Sprint B5
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="Priceflag <alerts@example.com>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin, no trailing slash. ngrok/cloudflared while developing, Vercel in prod.
APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts Shopify access tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Shared secret guarding the evaluator cron endpoint. Any long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
