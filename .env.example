# Priceflag — environment. Copy to .env.local and fill in.
# Everything here has a free tier. Demo mode needs none of it.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# demo = simulated store, file-backed state, no network. real = Shopify + Supabase.
PRICEFLAG_MODE=demo

# Local operator credential for scripts/vercel-setup.sh and
# scripts/vercel-stage.sh. It is read locally and never pushed as app runtime
# configuration. Use a short-lived token scoped to the pinned Priceflag team.
VERCEL_TOKEN=

# Local operator credential used by smoke-browser.ts and the attested CP4
# test-store chain. Obtain it from the pinned Vercel project; never print it.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Where DemoAdapter persists its state (demo mode only).
# PRICEFLAG_DEMO_STATE=.priceflag/demo-state.json

# How long GET /api/health waits for the database before reporting it down.
# Integer milliseconds, 10–10000; anything else falls back to 5000.
# PRICEFLAG_HEALTH_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Shopify (Partner account -> development store -> custom app; free, no review)
# ---------------------------------------------------------------------------
# --- Path A: admin-created custom app (dev store; what B3's sync runs against) ---
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps.
# This app type authenticates with a STATIC Admin API token: no OAuth, no install
# flow. It also has full order history WITHOUT `read_all_orders` — that scope is
# not offered in the admin checkbox list, and asking for it in OAuth fails.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# --- Path B: Partner-Dashboard app with custom distribution (pilots; OAuth) ---
# Needed to install on stores you do not own. `read_all_orders` and
# protected-customer-data access must be requested and approved for this path.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# App-home slug from Shopify Dev Dashboard (not the client ID), used in
# https://admin.shopify.com/store/<store>/apps/<handle> after install.
SHOPIFY_APP_HANDLE=
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_all_orders
# Admin GraphQL API version. Shopify versions quarterly (Jan/Apr/Jul/Oct);
# each version is supported for 12 months. Verify at shopify.dev before bumping.
SHOPIFY_API_VERSION=2026-07

# ---------------------------------------------------------------------------
# Supabase (free tier)
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable ("anon") key — Supabase → Project Settings → API. This one IS
# meant to be public: it is what emails somebody a magic link before they are
# signed in, and it can do nothing else. `SUPABASE_ANON_KEY` is also accepted,
# for projects created before Supabase renamed it.
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Accounts (magic-link sign-in) — signin.priceflag.org
# ---------------------------------------------------------------------------
# Signs the `pf_user` session cookie. Its OWN secret, never APP_ACCESS_SECRET:
# that one is a shared invite password, so reusing it here would let anybody
# holding a preview link forge a session for any email address they liked.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=

# Where unauthenticated browsers are sent, and the origin allowed to POST to
# /api/auth/magic-link. Both default to https://signin.priceflag.org.
SIGNIN_URL=
# Comma-separated, if the sign-in screen is ever served from more than one host.
SIGNIN_ORIGINS=

# Leave UNSET unless you need it. Unset makes the session cookie host-only,
# which is the tighter default and all the app requires. Set it to
# `.priceflag.org` only if a sibling subdomain ever needs the same session —
# that widens delivery to every subdomain, the static marketing site included.
AUTH_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Email (Resend free tier) — landed in Sprint B5
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend or alerts land in spam. Defaults to
# "Priceflag <kabir@priceflag.org>" when unset.
RESEND_FROM="Priceflag <kabir@priceflag.org>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin, no trailing slash. ngrok/cloudflared while developing, Vercel in prod.
APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts Shopify access tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# INTERIM access gate for the whole app (middleware.ts). Vercel's Standard
# Protection exempts the production domain, so without this the dashboard and
# every mutating route are public. NOT authentication — it identifies nobody and
# scopes nothing. Merchant API routes independently require a fresh Shopify App
# Bridge session token and derive the tenant only from its signed claims.
# Reach the app once with ?access=<secret>; it sets an HttpOnly cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_ACCESS_SECRET=

# Demo credentials handed to reviewers (YC and similar). Accepted over HTTP
# Basic by middleware.ts, and deliberately SEPARATE from APP_ACCESS_SECRET so
# they can be revoked the day a review ends without breaking
# smoke-browser.ts or any ?access= link. Unset DEMO_PASSWORD to revoke — the
# cookie a demo login mints holds the password, so sessions die with it.
DEMO_USERNAME=
DEMO_PASSWORD=

# Shared secret for POST /api/ml/export and POST /api/ml/ingest. The worker
# receives no database credential; all reads and writes stay behind the app's
# narrow contracts, validation and server-only Supabase client.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ML_INGEST_SECRET=

# Shared secret guarding the evaluator cron endpoint. Any long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Required by the beta deployment scripts: comma-separated exact invited-shop
# UUIDs and/or *.myshopify.com domains. Runtime still treats it as optional for
# local development; an empty or malformed configured value fails closed.
PRICEFLAG_SHOP_ALLOWLIST=

# Direct Postgres connection string for the Supabase project, used by
# scripts/supabase-staging-guard.ts (and `supabase db push`) to apply
# migrations. Never read at runtime — scripts only. Find it in the Supabase
# dashboard under Database → Connection string (URI).
SUPABASE_DB_URL=

# Base URL scripts/smoke-browser.ts drives. Defaults to http://localhost:3000;
# point it at a preview or production deployment to smoke-test that instead.
PRICEFLAG_URL=

# ---------------------------------------------------------------------------
# Test gates (local + CI only; never read by the running app)
# ---------------------------------------------------------------------------
# Set to `true` to make the integration suite FAIL (rather than skip) when
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are missing.
# REQUIRE_SUPABASE_TESTS=false
# Set to `true` to make the ML ingest test hit the real deployment instead of
# the in-process fake.
# REQUIRE_REAL_INGEST=false

# ---------------------------------------------------------------------------
# ML worker (ml/ — the nightly fit and recommendation pipeline)
# ---------------------------------------------------------------------------
# The worker talks to the app over HTTPS with ML_INGEST_SECRET only; it never
# holds a database credential. All four are required for a real (non-fake) run,
# and the two EXPECTED_* values are the pinned-target guard: the worker refuses
# to read from or write to any deployment that does not match them.
# PRICEFLAG_APP_URL=https://dashboard.priceflag.org
# PRICEFLAG_EXPECTED_APP_URL=https://dashboard.priceflag.org
# `production` or `preview`, matched against the resolved Vercel deployment.
# PRICEFLAG_EXPECTED_VERCEL_TARGET=production
# Which Supabase project ref and environment the staging gate must attest.
# PRICEFLAG_ML_EXPECTED_PROJECT_REF=
# PRICEFLAG_ML_EXPECTED_ENVIRONMENT=

# ---------------------------------------------------------------------------
# Injected by the platform — do NOT set these yourself
# ---------------------------------------------------------------------------
# NODE_ENV, VERCEL_ENV, VERCEL_PROJECT_PRODUCTION_URL come from Vercel/Next.js;
# GITHUB_REPOSITORY, GITHUB_SHA, GITHUB_TOKEN come from GitHub Actions. The code
# reads them to decide "is this production" and to attest CI provenance.
