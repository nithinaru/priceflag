{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    // `noUncheckedIndexedAccess` is NOT set here on purpose. It is genuinely
    // valuable, but it is a lane-wide taste decision that would break code the
    // other lanes had already written, and `next build` has to stay green for
    // everybody. Lane B keeps the guarantee for its own paths via
    // `tsconfig.strict.json` (`npm run typecheck` runs both).
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "ml"]
}
